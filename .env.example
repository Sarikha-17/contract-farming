PORT=5000
# MongoDB Atlas connection string (do not commit the real one)
MONGODB_URI=mongodb://localhost:27017/contract_farming
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
NODE_ENV=development
# Allowed browser origin(s) for CORS, comma separated. Set to your Vercel URL in production.
CLIENT_URL=http://localhost:5173
# When true, every new registration is marked verified automatically so the demo
# works without the admin approval step. Default: false (admin must verify users).
AUTO_VERIFY_USERS=true
